digraph {graph [fontname="Times New Roman", bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.6"]; node [fontname="Times New Roman", fontsize=14, shape=box, style="rounded", color="#222222"]; edge [fontname="Times New Roman", fontsize=11, color="#222222"]; rankdir=LR;node[shape=plain];u[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2"><B>utilities</B></TD></TR><TR><TD>PK</TD><TD ALIGN="LEFT">id BIGINT</TD></TR><TR><TD></TD><TD ALIGN="LEFT">name VARCHAR(100)</TD></TR><TR><TD>N</TD><TD ALIGN="LEFT">description VARCHAR(500)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">status VARCHAR(15)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">image_url, video_url VARCHAR(255)</TD></TR><TR><TD>N</TD><TD ALIGN="LEFT">tariff_rate NUMERIC(10,2)</TD></TR><TR><TD>N</TD><TD ALIGN="LEFT">consumption_norm NUMERIC(10,3)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">measurement_unit VARCHAR(20)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">created_at TIMESTAMPTZ</TD></TR><TR><TD>N</TD><TD ALIGN="LEFT">published_at TIMESTAMPTZ</TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT">creator_id BIGINT</TD></TR></TABLE>>]; users[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2"><B>users</B></TD></TR><TR><TD>PK</TD><TD ALIGN="LEFT">id BIGINT</TD></TR><TR><TD>U</TD><TD ALIGN="LEFT">login VARCHAR(50)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">password VARCHAR(100)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">is_moderator BOOLEAN</TD></TR></TABLE>>]; likes[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2"><B>likes</B></TD></TR><TR><TD>PK</TD><TD ALIGN="LEFT">id BIGINT</TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT">user_id BIGINT</TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT">utility_id BIGINT</TD></TR><TR><TD COLSPAN="2">UNIQUE(user_id, utility_id)</TD></TR></TABLE>>];users->u [dir=both,arrowtail=tee,arrowhead=crow,label="1 → 0..*"];users->likes [dir=both,arrowtail=tee,arrowhead=crow,label="1 → 0..*"];u->likes [dir=both,arrowtail=tee,arrowhead=crow,label="1 → 0..*"];}