digraph {graph [fontname="Times New Roman", bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.6"]; node [fontname="Times New Roman", fontsize=14, shape=box, style="rounded", color="#222222"]; edge [fontname="Times New Roman", fontsize=11, color="#222222"];rankdir=TB;node[shape=box];a[label="POST /api/users/login: login, password"];b[label="200: JWT; Authorization: Bearer JWT"];c[label="GET /api/utilities?tariff=50 → 200, isMine"];d[label="POST /api/utilities: name, image, video\n→ 201, id черновика"];e[label="GET /api/utilities/draft → 200"];f[label="PUT /api/utilities/{id}: поля услуги\n→ 200, published"];g[label="GET /api/utilities/feed → первая услуга"];h[label="GET /api/utilities/feed/{id}?next=true\n→ следующая услуга, liked, creator"];i[label="POST /api/utilities/{id}/like: value=1\n→ liked=1, likesCount"];a->b->c->d->e->f->g->h->i;}