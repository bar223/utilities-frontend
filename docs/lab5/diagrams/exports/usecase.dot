digraph {graph [fontname="Times New Roman", bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.6"]; node [fontname="Times New Roman", fontsize=14, shape=box, style="rounded", color="#222222"]; edge [fontname="Times New Roman", fontsize=11, color="#222222"]; rankdir=LR; guest [shape=plaintext,label="Гость"]; creator [shape=plaintext,label="Создатель\n(JWT, бэкенд ЛР-4)"]; subgraph cluster_app {label="Квитанция по квартплате"; list [shape=ellipse,label="Просматривать плитку"]; filter [shape=ellipse,label="Фильтровать по тарифу"]; feed [shape=ellipse,label="Просматривать ленту"]; next [shape=ellipse,label="Открывать следующую услугу"]; publish [shape=ellipse,label="Создавать и публиковать услугу\nчерез API"]; like [shape=ellipse,label="Ставить и снимать лайк\nчерез API"]; } guest->list [arrowhead=none];guest->filter [arrowhead=none];guest->feed [arrowhead=none];guest->next [arrowhead=none];creator->publish [arrowhead=none];creator->like [arrowhead=none];creator->guest [arrowhead=empty,label="наследует просмотр"];}